cell-icons-title = Terminal icon check
cell-icons-sample =
    Look for a trash can on the first line and check that both Bs line up. If you see a dash, a box, or another symbol, choose Use ASCII.
    A{ $icon }B
    A.B
    { $guidance }
cell-icons-install-local = If the sample is wrong after a font update, fully quit and reopen your terminal and recheck in Appearance. You can also select Tundra Cell Atlas as a fallback font.
cell-icons-install-remote = Install assets/cell-icons/TundraCellAtlas.ttf on the device displaying this terminal.
cell-icons-install-unsupported = If needed, install assets/cell-icons/TundraCellAtlas.ttf on the device displaying this terminal and recheck in Appearance.
cell-icons-install-conflict = Your existing Tundra Cell Atlas font or registration was kept. If the sample is wrong, update that font on the device running your terminal and recheck.
cell-icons-install-failed = Font installation failed ({ $error }).
cell-icons-guidance-session = { $guidance } Your choice applies to this session.
cell-icons-check-failed = The terminal icon check could not finish.
cell-icons-save-failed = Could not remember the terminal icon choice ({ $error }).
cell-icons-use-ascii = Use ASCII
cell-icons-suppress = Don't ask for this terminal
cell-icons-looks-right = Looks right
cell-icons-close = Close
